<Window x:Class="SidePeek.App.Views.ScreenshotToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SidePeek 截图工具栏" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" FontFamily="Microsoft YaHei UI"
        FontSize="13" TextElement.Foreground="#F3F5F8">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="Background" Value="#353D4B" />
            <Setter Property="BorderBrush" Value="#59677B" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#75C5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#F3F5F8" />
            <Setter Property="Background" Value="#353D4B" />
            <Setter Property="BorderBrush" Value="#59677B" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Body" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Body" Property="Background" Value="#175985" />
                                <Setter TargetName="Body" Property="BorderBrush" Value="#75C5FF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Body" Property="BorderBrush" Value="#75C5FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Body" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F21D2430" BorderBrush="#59677B" BorderThickness="1"
            CornerRadius="12" Padding="10">
        <StackPanel>
            <WrapPanel x:Name="ToolsRow">
                <ToggleButton x:Name="WindowTool" Content="窗口吸附 W" Tag="Window" Click="OnTool"
                              ToolTip="点击窗口吸附选区，也可拖动框选；重新选择会清除标注" />
                <ToggleButton x:Name="AreaTool" Content="矩形框选 A" Tag="Area" Click="OnTool"
                              ToolTip="拖动框选任意区域；重新选择会清除标注" />
                <ToggleButton x:Name="AdjustTool" Content="调整选区 V" Tag="Adjust" Click="OnTool" />
                <ToggleButton x:Name="RectangleTool" Content="矩形标注 R" Tag="Rectangle" Click="OnTool" />
                <ToggleButton x:Name="PenTool" Content="画笔 P" Tag="Pen" Click="OnTool" />
                <Button x:Name="UndoButton" Content="撤销" Click="OnUndo" ToolTip="Ctrl+Z" />
                <Button x:Name="RedoButton" Content="重做" Click="OnRedo" ToolTip="Ctrl+Shift+Z / Ctrl+Y" />
            </WrapPanel>
            <WrapPanel>
                <StackPanel x:Name="ColorPanel" Orientation="Horizontal" Margin="3,5,8,5" />
                <TextBlock Text="粗细" VerticalAlignment="Center" Margin="3,0,6,0" />
                <ComboBox x:Name="WidthPicker" Width="82" Margin="0,3,10,3"
                          SelectionChanged="OnWidthChanged" ToolTip="标注在截图中的像素宽度" />
                <Button x:Name="SaveButton" Content="保存 PNG" Click="OnSave" ToolTip="Ctrl+S" />
                <Button x:Name="CopyButton" Content="复制" Background="#175985" Click="OnCopy" ToolTip="Ctrl+C / Enter" />
                <Button Content="取消 Esc" Click="OnCancel" />
            </WrapPanel>
            <TextBlock x:Name="StatusText" Margin="4,5,4,0" TextWrapping="Wrap" Foreground="#B8C8DA" />
        </StackPanel>
    </Border>
</Window>
